<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/hivePic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        app:srcCompat="@drawable/hive" />

    <TextView
        android:id="@+id/hiveName"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@+id/hivePic"
        android:maxLines="1"
        android:text="Hive Name"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/locationPic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_below="@+id/hiveName"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        app:srcCompat="@drawable/location" />

    <TextView
        android:id="@+id/hiveLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/hiveName"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@+id/locationPic"
        android:gravity="center"
        android:text="location"
        android:textStyle="italic"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/statusPic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="270dp"
        android:layout_marginTop="15dp"
        app:srcCompat="@drawable/connection" />

    <TextView
        android:id="@+id/hiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/statusPic"
        android:layout_marginStart="215dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/locationPic"
        android:gravity="center"
        android:text="hiveStatus: Unknown"
        android:textStyle="bold"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/hiveTypePic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_below="@+id/hiveLocation"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        app:srcCompat="@drawable/type" />

    <TextView
        android:id="@+id/hiveType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/hiveLocation"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="20dp"
        android:layout_toEndOf="@+id/hiveTypePic"
        android:gravity="center"
        android:text="type"
        android:textStyle="italic"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/border2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:background="#808080" />

</RelativeLayout>