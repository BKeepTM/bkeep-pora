<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.Bkeep" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- STATUS BAR BARVA -->
        <item name="android:statusBarColor">@color/light_yellow</item>

        <!-- Temne ikone v status baru (ker je svetla barva) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- (Optional) navigation bar -->
        <item name="android:navigationBarColor">@color/light_yellow</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <!-- App theme -->
    <style name="Theme.Bkeep" parent="Base.Theme.Bkeep"/>

</resources>
